// Implementação de referência do Repository com Supabase. NÃO foi testada: ajuste conforme necessário.
// Para ativar: renomeie para supabase.ts e troque o export em ./index.ts.
//
// Dependências:
//   npx expo install @supabase/supabase-js @react-native-async-storage/async-storage react-native-url-polyfill
import 'react-native-url-polyfill/auto';
import AsyncStorage from '@react-native-async-storage/async-storage';
import { createClient } from '@supabase/supabase-js';
import { MEASURE_KEYS, Goal, Measures, Profile, Workout, WorkoutLog } from '../../types';
import { Repository } from './repository';

export const supabase = createClient(
  process.env.EXPO_PUBLIC_SUPABASE_URL!,
  process.env.EXPO_PUBLIC_SUPABASE_ANON_KEY!,
  { auth: { storage: AsyncStorage, autoRefreshToken: true, persistSession: true, detectSessionInUrl: false } },
);

async function uid() {
  const { data } = await supabase.auth.getUser();
  if (!data.user) throw new Error('Não autenticado');
  return data.user.id;
}

const toProfile = (r: any): Profile => ({
  id: r.id, name: r.name, email: r.email, age: r.age,
  weight: r.weight_kg == null ? null : Number(r.weight_kg),
  height: r.height_m == null ? null : Number(r.height_m),
  goalId: r.goal_id, remindersEnabled: r.reminders_enabled,
});

export const supabaseRepository: Repository = {
  async getProfile() {
    const { data, error } = await supabase.from('profiles').select('*').eq('id', await uid()).single();
    if (error) throw error;
    return toProfile(data);
  },

  async updateProfile(patch) {
    const row: Record<string, unknown> = {};
    if ('name' in patch) row.name = patch.name;
    if ('email' in patch) row.email = patch.email;
    if ('age' in patch) row.age = patch.age;
    if ('weight' in patch) row.weight_kg = patch.weight;
    if ('height' in patch) row.height_m = patch.height;
    if ('goalId' in patch) row.goal_id = patch.goalId;
    if ('remindersEnabled' in patch) row.reminders_enabled = patch.remindersEnabled;
    const { data, error } = await supabase.from('profiles').update(row).eq('id', await uid()).select().single();
    if (error) throw error;
    return toProfile(data);
  },

  async getMeasures() {
    const { data, error } = await supabase.from('body_measurements').select('site,value_cm');
    if (error) throw error;
    const m = Object.fromEntries(MEASURE_KEYS.map((k) => [k, null])) as Measures;
    for (const r of data ?? []) if (r.site in m) (m as any)[r.site] = r.value_cm == null ? null : Number(r.value_cm);
    return m;
  },

  async saveMeasures(m) {
    const user_id = await uid();
    const rows = MEASURE_KEYS.map((k) => ({ user_id, site: k, value_cm: m[k], updated_at: new Date().toISOString() }));
    const { error } = await supabase.from('body_measurements').upsert(rows);
    if (error) throw error;
    return m;
  },

  async listGoals() {
    const { data, error } = await supabase.from('goals').select('*');
    if (error) throw error;
    return (data ?? []) as Goal[];
  },

  async listWorkouts() {
    const { data, error } = await supabase
      .from('workouts').select('id,goal_id,name,focus,position,exercises(id,name,sets,reps,position)').order('position');
    if (error) throw error;
    return (data ?? []).map((w: any): Workout => ({
      id: w.id, goalId: w.goal_id, name: w.name, focus: w.focus,
      exercises: [...w.exercises].sort((a, b) => a.position - b.position)
        .map((e: any) => ({ id: e.id, name: e.name, sets: e.sets, reps: e.reps })),
    }));
  },

  async listLogs() {
    const { data, error } = await supabase
      .from('workout_logs').select('id,workout_id,workout_name,performed_at,set_logs(*)')
      .order('performed_at', { ascending: false });
    if (error) throw error;
    return (data ?? []).map((l: any): WorkoutLog => {
      const byEx = new Map<string, WorkoutLog['exercises'][number]>();
      for (const s of [...l.set_logs].sort((a, b) => a.set_number - b.set_number)) {
        const key = s.exercise_id ?? s.exercise_name;
        if (!byEx.has(key)) byEx.set(key, { exerciseId: key, exerciseName: s.exercise_name, sets: [] });
        byEx.get(key)!.sets.push({ load: Number(s.load_kg), reps: s.reps });
      }
      return { id: l.id, workoutId: l.workout_id, workoutName: l.workout_name, date: l.performed_at, exercises: [...byEx.values()] };
    });
  },

  async addLog(log) {
    const user_id = await uid();
    const { data: row, error } = await supabase.from('workout_logs')
      .insert({ user_id, workout_id: log.workoutId, workout_name: log.workoutName, performed_at: log.date })
      .select('id').single();
    if (error) throw error;
    const sets = log.exercises.flatMap((e) => e.sets.map((s, i) => ({
      log_id: row.id, exercise_id: e.exerciseId, exercise_name: e.exerciseName,
      set_number: i + 1, load_kg: s.load, reps: s.reps,
    })));
    const { error: e2 } = await supabase.from('set_logs').insert(sets);
    if (e2) throw e2;
    return { ...log, id: row.id };
  },

  // CoachPro: crie uma Edge Function "coach" que chame o modelo de IA (a chave fica no servidor, nunca no app).
  async coachReply(history, text) {
    const { data, error } = await supabase.functions.invoke('coach', { body: { history, text } });
    if (error) throw error;
    return data.reply as string;
  },
};
